# =============================================================================
# .env.docker — Docker environment overrides for Vogo Chatbot
# =============================================================================
# This file is used ONLY inside Docker containers.
# Uses Docker service names instead of localhost for inter-container comms.
# IMPORTANT: Never commit real API keys — update these before deploying!
# =============================================================================

SERVER_PORT=3001

# Vogo API
VOGO_API_BASE=https://vogo.me/wp-json
VOGO_USERNAME=app_mobile_general@vogo.family
VOGO_PASSWORD=Abc123$
ENABLE_API_CALLS=true

# =============================================================================
# OLLAMA (Native Llama 3.1 — Docker service name "ollama" resolves internally)
# =============================================================================
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b

# Set Ollama as primary model for all roles
AI_MODEL_GENERAL=ai_ollama
AI_MODEL_VIP=ai_ollama
AI_MODEL_ADMIN=ai_ollama
AI_MODEL_BASIC=ai_basic

# =============================================================================
# RASA NLU (DIET Classifier — Docker service name "rasa-nlu" on port 5005)
# =============================================================================
RASA_URL=http://rasa-nlu:5005
# To use Rasa as PRIMARY NLU engine, change AI_MODEL_* above to ai_rasa:
# AI_MODEL_GENERAL=ai_rasa
# AI_MODEL_VIP=ai_rasa
# AI_MODEL_ADMIN=ai_rasa

# =============================================================================
# GROQ (fallback if Ollama is slow or unavailable)
# =============================================================================
GROQ_API_KEY=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
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=300
GROQ_TEMPERATURE=0.3

# =============================================================================
# OPENAI (VIP users fallback)
# =============================================================================
OPENAI_API_KEY=sk-proj-9AeE5GtvVEA2H4tJdKW1jp6Cfek-abTMi_wSd1V7Adc2NIRv2H2hvaNvOrINhMgV8UnZXNWP_VT3BlbkFJGYrby2Fuf_qnAuhYY4ZUvYAPl1S2Lx9FafltTI93bLBuBySTXw7Ze12SCoTT1D7BgcZ3hk_gA
OPENAI_MODEL=gpt-4o-mini

# =============================================================================
# GEMINI
# =============================================================================
GEMINI_API_KEY=AIzaSyBqKnFP3lb70FUhpFYsgHsGSy-gu_ty7-8
GEMINI_MODEL=gemini-2.5-flash

# =============================================================================
# ANTHROPIC (Claude)
# =============================================================================
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307

# =============================================================================
# VOICE BACKEND (Python FastAPI)
# =============================================================================
VOICE_BACKEND_URL=http://voice:8000

# =============================================================================
# MYSQL (Docker service name "mysql")
# =============================================================================
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=vogo_chatbot
MYSQL_USER=vogo
MYSQL_PASSWORD=vogopass123
MYSQL_ROOT_PASSWORD=vogosecret123

# =============================================================================
# LOGGING
# =============================================================================
SHOW_DETAILED_LOGS=true
